---
/**
 * 04 — Performance.
 * A stat band, not a card grid: the numbers are the argument, so they get the
 * type. One small honest chart of resident memory idle vs under load, and the
 * caveat always visible underneath. Never a comparison.
 *
 * The chart used to plot two cold-start samples. Once startup settled at ~37 ms
 * in both runs the bars were the same length and the average marker said
 * nothing, so it plots the memory ladder instead: the same measurement the
 * RSS stats come from, showing that it grows with work and stays small.
 */
import SectionHead from '../ui/SectionHead.astro';

const STATS = [
  { value: '37.4', unit: 'ms', label: 'Cold start', note: 'average of 37.5 / 38.1 / 36.6' },
  { value: '19.2', unit: 'MiB', label: 'Idle RSS', note: 'sampled after 3 s idle' },
  { value: '28.0', unit: 'MiB', label: 'Peak RSS', note: 'with 3 concurrent runs' },
  { value: '27.9', unit: 'MiB', label: 'Binary', note: 'UI embedded, strip + thin LTO' },
  { value: '266', unit: 'ms', label: '3 runs, wall', note: 'three concurrent runs' },
];

// resident memory, MiB: idle, then with three runs streaming
const MEM = [
  { label: 'idle', mib: 19.2 },
  { label: '3 runs', mib: 28.0 },
];
const MAX = Math.max(...MEM.map((r) => r.mib));

// cold start, ms: three polled runs — the spread is the honest part
const START = [37.5, 38.1, 36.6];
const START_AVG = START.reduce((a, b) => a + b, 0) / START.length;
---

<section class="section section--divided" id="performance" aria-labelledby="performance-head">
  <div class="wrap">
    <div class="reveal">
      <SectionHead
        num="04"
        kicker="Performance"
        title="Twenty-eight megabytes on disk, nineteen in memory."
        lede="Measured on one host with a local mock provider — cold start polled on /api/health, RSS sampled after three seconds idle and during three concurrent runs."
        id="performance-head"
      />
    </div>

    <p class="band__cap mono">measured, not promised · one host · mock provider</p>

    <ul class="stats">
      {
        STATS.map((s) => (
          <li class="stat">
            <span class="stat__label mono">{s.label}</span>
            <span class="stat__value">
              <span class="stat__num">{s.value}</span>
              <span class="stat__unit">{s.unit}</span>
            </span>
            <span class="stat__note mono">{s.note}</span>
          </li>
        ))
      }
    </ul>

    <div class="perf__foot">
      <figure class="chart">
        <figcaption class="chart__cap mono">
          Resident memory — idle, then three runs streaming
        </figcaption>
        <div class="chart__plot">
          <div class="chart__rows">
            {
              MEM.map((r) => (
                <div class="chart__row">
                  <span class="chart__label mono">{r.label}</span>
                  <span class="chart__track">
                    <span class="chart__bar" style={`--w:${((r.mib / MAX) * 100).toFixed(1)}%`} />
                  </span>
                  <span class="chart__val mono">{r.mib.toFixed(1)}</span>
                </div>
              ))
            }
          </div>
        </div>
        <div class="chart__axis mono" aria-hidden="true">
          <span>0</span>
          <span>{MAX.toFixed(1)} MiB</span>
        </div>
      </figure>

      <figure class="chart">
        <figcaption class="chart__cap mono">
          Cold start — three runs, polled on <span>/api/health</span>
        </figcaption>
        <div class="chart__dots" role="img" aria-label={`Cold start, three runs: ${START.join(', ')} milliseconds, average ${START_AVG.toFixed(1)} milliseconds.`}>
          {
            START.map((ms, i) => (
              <span class="dot" style={`--x:${((i + 0.5) / START.length) * 100}%; --y:${((ms - 36) / 2.5) * 100}%`}>
                <span class="dot__val mono">{ms.toFixed(1)}</span>
              </span>
            ))
          }
          <span class="dot__avg" style={`--y:${((START_AVG - 36) / 2.5) * 100}%`} aria-hidden="true"></span>
        </div>
        <div class="chart__axis chart__axis--start mono" aria-hidden="true">
          <span>run 1</span>
          <span>run 2</span>
          <span>run 3</span>
        </div>
        <p class="chart__avg mono">
          avg <span>{START_AVG.toFixed(1)} ms</span> — the spread, not a single number
        </p>
      </figure>

      <p class="caveat mono">
        Host: AMD Ryzen 7 3700X, Linux 6.12, rustc 1.96, release build with strip + thin LTO.
        The binary embeds the whole web UI and its fonts; that is why most of it is not agent code.
        Numbers are specific to this host and to the mock provider; RSS during a real run also
        depends on the provider TLS stack and response sizes. No memory target is promised.
      </p>
    </div>
  </div>
</section>

<style>
  .band__cap {
    display: block;
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-3);
    padding-bottom: 12px;
    border-bottom: 1px solid var(--line);
  }

  .stats {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  @media (min-width: 360px) {
    .stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 860px) {
    .stats {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 1080px) {
    .stats {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }

  .stat {
    display: grid;
    gap: 4px;
    padding: 20px 20px 22px 0;
    border-bottom: 1px solid var(--line-soft);
  }

  @media (min-width: 1080px) {
    .stat {
      padding-left: 22px;
      border-bottom: 0;
      border-left: 1px solid var(--line);
    }

    .stat:first-child {
      padding-left: 0;
      border-left: 0;
    }
  }

  .stat__label {
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-3);
  }

  .stat__value {
    display: flex;
    align-items: baseline;
    gap: 0.4ch;
    font-family: var(--kc-font-mono);
    font-variant-numeric: tabular-nums;
    line-height: 1;
    color: var(--text);
    letter-spacing: -0.03em;
  }

  .stat__num {
    font-size: clamp(1.9rem, 3vw, 2.6rem);
    font-weight: 400;
  }

  .stat__unit {
    font-size: 0.8125rem;
    letter-spacing: 0.02em;
    color: var(--text-3);
  }

  .stat__note {
    font-size: 0.75rem;
    line-height: 1.4;
    color: var(--text-3);
  }

  /* ── foot: chart + caveat ──────────────────────────────────────────── */
  .perf__foot {
    display: grid;
    gap: clamp(20px, 3vw, 36px);
    margin-top: clamp(28px, 3.5vw, 44px);
    padding-top: clamp(20px, 2.5vw, 28px);
    border-top: 1px solid var(--line);
  }

  @media (min-width: 900px) {
    .perf__foot {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: clamp(32px, 5vw, 72px);
      align-items: start;
    }
  }

  .chart {
    display: grid;
    gap: 10px;
    margin: 0;
  }

  .chart__cap {
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-3);
  }

  .chart__cap span {
    color: var(--text-2);
    text-transform: none;
  }

  .chart__rows {
    display: grid;
    gap: 10px;
  }

  .chart__row {
    display: grid;
    /* wide enough for the two-word label "3 runs"; at 44px it broke into "3"/"RUNS" */
    grid-template-columns: 58px minmax(0, 1fr) 62px;
    gap: 10px;
    align-items: center;
  }

  .chart__label {
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-3);
  }

  .chart__track {
    display: block;
    height: 6px;
    background: var(--line-soft);
    border-radius: 2px;
    overflow: hidden;
  }

  .chart__bar {
    display: block;
    height: 100%;
    width: var(--w, 0%);
    background: var(--text-2);
    border-radius: 2px;
  }

  .chart__val {
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
    color: var(--text-2);
    text-align: right;
  }

  .chart__axis {
    display: grid;
    grid-template-columns: 58px minmax(0, 1fr) 62px;
    gap: 10px;
    font-size: 0.6875rem;
    color: var(--text-3);
  }

  .chart__axis span:first-child {
    grid-column: 2;
  }

  .chart__axis span:last-child {
    text-align: right;
  }

  /* cold-start scatter: three points, their average, the spread visible */
  .chart__dots {
    position: relative;
    display: block;
    height: 84px;
    border-left: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    margin: 4px 0 2px;
  }

  .dot {
    position: absolute;
    left: var(--x, 50%);
    bottom: calc(var(--y, 50%) + 8px);
    width: 7px;
    height: 7px;
    margin: -3.5px 0 0 -3.5px;
    border-radius: 50%;
    background: var(--text-2);
  }

  .dot__val {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    top: -18px;
    font-size: 0.6875rem;
    letter-spacing: 0.02em;
    color: var(--text-3);
    white-space: nowrap;
  }

  .dot__avg {
    position: absolute;
    left: 0;
    right: 0;
    bottom: calc(var(--y, 50%) + 8px);
    height: 0;
    border-top: 1px dashed var(--accent);
  }

  .chart__axis--start {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    text-align: center;
  }

  .chart__avg {
    margin: 8px 0 0;
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-3);
  }

  .chart__avg span {
    color: var(--accent);
  }

  .caveat {
    font-size: 0.8125rem;
    line-height: 1.7;
    letter-spacing: -0.01em;
    color: var(--text-3);
    max-width: 64ch;
  }
</style>