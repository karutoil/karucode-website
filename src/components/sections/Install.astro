---
/**
 * 06 — Install.
 *
 * There is exactly one install method and it is one line: packaging/install.sh
 * streamed into sh. The script downloads the released tarball, checks it against
 * the release SHA256SUMS and installs the binary (plus a systemd unit, unless you
 * say otherwise). The three tabs are modes of that one line, not competing
 * routes — no source build, no container, no cargo. Every command exists as
 * written.
 *
 * All panels are rendered in the HTML; JS only hides the inactive ones, so the
 * panel still reads with JS off.
 */
import SectionHead from '../ui/SectionHead.astro';
import Cmd from '../ui/Cmd.astro';

const TABS = [
  { id: 'service', label: 'As a service' },
  { id: 'user', label: 'No root' },
  { id: 'upgrade', label: 'Upgrade' },
];

/** The only install path there is. Streamed into sh; flags go after `sh -s --`. */
const INSTALLER = 'https://raw.githubusercontent.com/karutoil/karucode/main/packaging/install.sh';

const NOTES = [
  {
    label: 'checksum',
    body: 'The release tarball is verified against SHA256SUMS before anything is unpacked — the script is what gets piped, never the binary.',
  },
  {
    label: 'runs as you',
    body: 'The service runs as the account that ran the installer — never root. A system account only when no human can be identified.',
  },
  {
    label: 'next',
    body: 'Open 127.0.0.1:8787: the wizard takes the model endpoint and a password or passkey.',
  },
];
---

<section class="section section--divided" id="install" aria-labelledby="install-head">
  <div class="wrap">
    <div class="reveal">
      <SectionHead
        num="06"
        kicker="Install"
        title="One line, one binary, one service."
        lede="The line streams a plain shell script; the script checks the release tarball against SHA256SUMS, then installs the binary and a hardened systemd unit. No Rust, no Node, no container."
        id="install-head"
      />
    </div>

    <div class="tabs" data-tabs>
      <div class="tabs__list" role="tablist" aria-label="Installer modes">
        {
          TABS.map((t, i) => (
            <button
              class="tabs__tab mono"
              type="button"
              role="tab"
              id={`tab-${t.id}`}
              aria-controls={`panel-${t.id}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
            >
              {t.label}
            </button>
          ))
        }
      </div>

      <div class="tabs__panels">
        <div
          class="tpanel"
          role="tabpanel"
          id="panel-service"
          aria-labelledby="tab-service"
          tabindex="0"
        >
          <p class="tpanel__note">
            Paste one line. Flags go after <span class="mono">sh -s --</span> so the script itself
            still comes from the pipe; <span class="mono">--workspace</span> names the directory
            sessions start in.
          </p>
          <Cmd
            label="shell"
            wrap
            command={`curl -fsSL ${INSTALLER} | sudo sh -s -- --workspace /srv/karucode/workspace`}
          />
          <p class="tpanel__foot">
            It installs the binary to <span class="mono">/usr/local/bin</span>, writes a hardened
            systemd unit, enables it at boot, starts it, and reports success only once
            <span class="mono">/api/health</span> answers. The previous binary is kept as
            <span class="mono">karucode.old</span> and a failed start restores it. Drop
            <span class="mono">--workspace</span> and the server starts with no project, which you
            add in the web UI. <span class="mono">--dry-run</span> prints the whole plan first.
          </p>
        </div>

        <div
          class="tpanel"
          role="tabpanel"
          id="panel-user"
          aria-labelledby="tab-user"
          tabindex="0"
        >
          <p class="tpanel__note">
            The same line, with no root and no systemd: the binary goes into your own
            <span class="mono">~/.local/bin</span>.
          </p>
          <Cmd
            label="shell"
            wrap
            command={`curl -fsSL ${INSTALLER} | sh -s -- --prefix "$HOME/.local" --no-systemd`}
          />
          <p class="tpanel__foot">
            Then run it in the foreground with
            <span class="mono">karucode --workspace /path/to/project</span>. State lives in
            <span class="mono">~/.local/share/karucode</span>.
          </p>
        </div>

        <div
          class="tpanel"
          role="tabpanel"
          id="panel-upgrade"
          aria-labelledby="tab-upgrade"
          tabindex="0"
        >
          <p class="tpanel__note">
            Re-running the same line <em>is</em> the upgrade: it fetches the newest build and
            restarts the service. To stay on a build, pass <span class="mono">--version &lt;build&gt;</span>.
          </p>
          <Cmd
            label="shell"
            wrap
            command={`curl -fsSL ${INSTALLER} | sudo sh\ncurl -fsSL ${INSTALLER} | sudo sh -s -- --version 107`}
          />
          <p class="tpanel__foot">
            Your workspace, service user, port and data directory live in a drop-in at
            <span class="mono">/etc/systemd/system/karucode.service.d/10-install.conf</span> that
            every run rewrites from what it finds, so an upgrade cannot lose them. Versions are
            build numbers — every commit on <span class="mono">main</span> is a release.
            <span class="mono">karucode update --check</span> tells you whether a newer build
            exists, and Settings → Updates has the install button.
          </p>
        </div>
      </div>
    </div>

    <ul class="inotes">
      {
        NOTES.map((n) => (
          <li class="inote">
            <span class="inote__label mono">{n.label}</span>
            <span class="inote__body">{n.body}</span>
          </li>
        ))
      }
    </ul>

    <div class="cta">
      <a class="btn btn--primary btn--lg" href="/docs/quickstart/">
        Read the quick start
        <svg viewBox="0 0 12 12" width="12" height="12" aria-hidden="true" fill="none">
          <path
            d="M2.5 6h7M6.6 3 9.6 6l-3 3"
            stroke="currentColor"
            stroke-width="1.3"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </a>
      <span class="cta__note mono">MIT licensed · x86_64 Linux release · the installer verifies SHA256SUMS</span>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[role="tabpanel"]'));
    if (!tabs.length || !panels.length) return;

    const show = (index: number, focus: boolean) => {
      tabs.forEach((tab, i) => {
        const on = i === index;
        tab.setAttribute('aria-selected', String(on));
        tab.tabIndex = on ? 0 : -1;
      });
      panels.forEach((panel, i) => {
        panel.hidden = i !== index;
      });
      if (focus) tabs[index]?.focus({ preventScroll: true });
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => show(i, false));
      tab.addEventListener('keydown', (e) => {
        const keys = ['ArrowRight', 'ArrowLeft', 'Home', 'End'];
        if (!keys.includes(e.key)) return;
        e.preventDefault();
        let next = i;
        if (e.key === 'ArrowRight') next = (i + 1) % tabs.length;
        if (e.key === 'ArrowLeft') next = (i - 1 + tabs.length) % tabs.length;
        if (e.key === 'Home') next = 0;
        if (e.key === 'End') next = tabs.length - 1;
        show(next, true);
      });
    });

    show(0, false);
  });
</script>

<style>
  .tabs {
    border: 1px solid var(--line);
    border-radius: var(--kc-radius);
    background: var(--bg-raised);
    overflow: hidden;
  }

  .tabs__list {
    display: flex;
    gap: 2px;
    padding: 0 8px;
    border-bottom: 1px solid var(--line);
    background: var(--bg);
    overflow-x: auto;
    scrollbar-width: none;
  }

  .tabs__list::-webkit-scrollbar {
    display: none;
  }

  .tabs__tab {
    position: relative;
    padding: 13px 14px 12px;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-3);
    white-space: nowrap;
    transition: color var(--dur) var(--ease);
  }

  .tabs__tab:hover {
    color: var(--text);
  }

  .tabs__tab[aria-selected='true'] {
    color: var(--accent);
  }

  .tabs__tab[aria-selected='true']::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 1px;
    background: var(--accent);
  }

  .tabs__panels {
    padding: clamp(18px, 2.4vw, 28px);
  }

  .tpanel {
    display: grid;
    gap: 16px;
  }

  .tpanel[hidden] {
    display: none;
  }

  .tpanel__note {
    font-size: var(--fs-small);
    line-height: 1.55;
    color: var(--text-2);
    max-width: 62ch;
  }

  .tpanel__note .mono {
    color: var(--text);
  }

  .tpanel__foot {
    padding-top: 14px;
    border-top: 1px solid var(--line-soft);
    font-size: var(--fs-small);
    line-height: 1.55;
    color: var(--text-3);
    max-width: 68ch;
  }

  .tpanel__foot .mono {
    color: var(--text-2);
  }

  /* ── notes under the panel ─────────────────────────────────────────── */
  .inotes {
    display: grid;
    gap: 0;
    margin-top: clamp(18px, 2.2vw, 26px);
    border-top: 1px solid var(--line-soft);
  }

  @media (min-width: 760px) {
    .inotes {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: clamp(20px, 3vw, 40px);
    }
  }

  .inote {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr);
    gap: 14px;
    padding: 14px 0;
    border-bottom: 1px solid var(--line-soft);
  }

  @media (max-width: 520px) {
    .inote {
      grid-template-columns: minmax(0, 1fr);
      gap: 4px;
    }
  }

  .inote__label {
    font-size: 0.625rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--accent);
    padding-top: 2px;
  }

  .inote__body {
    font-size: var(--fs-small);
    line-height: 1.5;
    color: var(--text-2);
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 22px;
    margin-top: clamp(24px, 3vw, 36px);
  }

  .cta__note {
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-3);
  }
</style>