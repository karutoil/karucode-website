---
import { FOOTER_LINKS, SITE } from '../../site';

const year = new Date().getFullYear();
---

<footer class="foot">
  <div class="wrap wrap--wide foot__inner">
    <div class="foot__brand">
      <a class="foot__logo" href="/" aria-label="karucode — home">
        <img src="/brand/mark.svg" alt="" width="28" height="28" aria-hidden="true" />
        <span class="foot__word">karu<span>code</span></span>
      </a>
      <p class="foot__tag">{SITE.tagline}</p>
      <p class="foot__facts mono">{SITE.facts}</p>
      <div class="foot__meta">
        <span>{SITE.license} licensed</span>
        <span aria-hidden="true">/</span>
        <span>Rust {SITE.rust}</span>
        <span aria-hidden="true">/</span>
        <span>no telemetry</span>
      </div>
    </div>

    <div class="foot__cols">
      {
        FOOTER_LINKS.map((col) => (
          <div class="foot__col">
            <h2 class="foot__col-title">{col.title}</h2>
            <ul>
              {col.links.map((l) => (
                <li>
                  <a
                    href={l.href}
                    class:list={['foot__link']}
                    {...('external' in l && l.external
                      ? { target: '_blank', rel: 'noopener noreferrer' }
                      : {})}
                  >
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>

  <div class="foot__glyph" aria-hidden="true">
    <span>karu<span class="g">code</span></span>
  </div>

  <div class="wrap wrap--wide foot__base">
    <p>&copy; {year} karucode. Built in the open.</p>
    <p class="foot__caveat">Shell commands run as the server user. Approvals are the gate, not a sandbox.</p>
  </div>
</footer>

<style>
  .foot {
    position: relative;
    border-top: 1px solid var(--line);
    background: var(--bg-sunk);
    overflow: hidden;
    padding-top: clamp(48px, 6vw, 80px);
  }

  .foot__inner {
    display: grid;
    gap: clamp(36px, 6vw, 72px);
    padding-bottom: clamp(40px, 5vw, 64px);
  }

  @media (min-width: 880px) {
    .foot__inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    }
  }

  .foot__logo {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    margin-bottom: 16px;
  }

  .foot__word {
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.04em;
  }

  .foot__word span {
    color: var(--accent);
  }

  .foot__tag {
    color: var(--text-2);
    max-width: 34ch;
    text-wrap: balance;
  }

  .foot__facts {
    margin-top: 10px;
    font-size: 0.75rem;
    color: var(--text-3);
    letter-spacing: 0.01em;
  }

  .foot__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 20px;
    font-family: var(--kc-font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-3);
  }

  .foot__cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    gap: 28px;
  }

  .foot__col-title {
    font-family: var(--kc-font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--text-3);
    font-weight: 400;
    margin-bottom: 14px;
  }

  .foot__col ul {
    display: grid;
    gap: 9px;
  }

  .foot__link {
    font-size: 0.9375rem;
    color: var(--text-2);
    transition: color var(--dur) var(--ease);
  }

  .foot__link:hover {
    color: var(--accent);
  }

  /* Giant wordmark: clipped by the footer edge, purely decorative. */
  .foot__glyph {
    position: relative;
    display: flex;
    justify-content: center;
    overflow: hidden;
    height: clamp(58px, 10vw, 132px);
    border-top: 1px solid var(--line-soft);
    margin-top: clamp(8px, 2vw, 24px);
    user-select: none;
  }

  .foot__glyph span {
    font-size: clamp(7rem, 21vw, 19rem);
    line-height: 0.78;
    font-weight: 700;
    letter-spacing: -0.055em;
    color: transparent;
    -webkit-text-stroke: 1px rgb(234 233 229 / 0.16);
    position: relative;
    top: 6px;
    white-space: nowrap;
  }

  .foot__glyph .g {
    -webkit-text-stroke: 1px rgb(223 182 128 / 0.42);
  }

  .foot__base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    padding-block: 22px;
    border-top: 1px solid var(--line-soft);
    font-size: 0.75rem;
    color: var(--text-3);
  }

  .foot__caveat {
    font-family: var(--kc-font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.01em;
    opacity: 0.9;
  }
</style>
