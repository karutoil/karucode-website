---
/**
 * The docs home is the karucode repository's README, imported at build time.
 * Nothing on this page is written here: the front door, the quick start and the
 * contents table all come from `README.md`, so the site cannot drift from it.
 */
import { getEntry, render } from 'astro:content';
import Docs from '../../layouts/Docs.astro';
import DocsIndex from '../../components/docs/DocsIndex.astro';
import Source from '../../components/docs/Source.astro';
import { DOCS } from '../../../.karucode-docs/manifest';

const { home } = DOCS;
const entry = await getEntry('docs', home.id);
if (!entry) throw new Error(`docs: ${home.path} was not staged — run \`npm run sync:docs\``);
const { Content, headings } = await render(entry);

const toc = headings
  .filter((heading) => heading.depth === 2)
  .map((heading) => ({ id: heading.slug, label: heading.text }));

const first = DOCS.pages[0];
---

<Docs
  title={home.title}
  headTitle="Documentation"
  description={home.summary || undefined}
  path={home.url}
  section="Docs"
  lede={home.summary}
  toc={toc}
  edit={home.edit}
  next={first ? { href: first.url, title: first.title } : undefined}
>
  <Content />
  <DocsIndex />
  <Source />
</Docs>