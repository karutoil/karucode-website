# dependencies
node_modules/

# build output — regenerated by `npm run build`
dist/
.astro/
*.tsbuildinfo

# wrangler / Cloudflare Pages local state
.wrangler/
.dev.vars
.dev.vars.*
.env
.env.*

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# local preview / verification artefacts
screenshots/
*.local

# imported documentation — staged from the karucode repository by
# scripts/sync-docs.mjs before every dev/build/check. Never commit this: a
# committed copy is exactly the duplicate the import exists to avoid.
.karucode-docs/
.karucode-docs-cache/

# agent session state (goals, todo) — local, not part of the site
.karucode/
